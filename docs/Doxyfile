# Run from the repository root: doxygen docs/Doxyfile
PROJECT_NAME = MotorControl-RS
PROJECT_BRIEF = "ESS-RS core and standalone application API"
OUTPUT_DIRECTORY = build/doxygen
INPUT = include \
        examples/probe_cli/ProbeApp.h \
        examples/probe_cli/ProbeConsole.h \
        examples/probe_cli/AxisConsole.h \
        examples/probe_cli/DriveGroup.h \
        examples/probe_cli/MoveRelation.h \
        examples/probe_cli/PositionStage.h \
        examples/probe_cli/ProfileCandidate.h \
        examples/probe_cli/QualificationConsole.h \
        examples/probe_cli/IoQualification.h
RECURSIVE = YES
FILE_PATTERNS = *.h
EXTRACT_ALL = YES
GENERATE_HTML = YES
GENERATE_LATEX = NO
HAVE_DOT = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = YES
